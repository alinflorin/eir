# Copy to .env and fill in. Loaded by playwright.config.ts via dotenv.

# Origin the stack is reachable at (see ../../scripts/setup-dev.sh /
# docker-compose.yml — Caddy fronts the UI at this host).
E2E_BASE_URL=https://eir.localhost

# Credentials for the Dex static test user (see ../../dex-config.yml,
# staticPasswords). The password is the plaintext behind
# DEX_ADMIN_PASSWORD_HASH in the repo-root .env — it isn't derivable from
# the hash, so set it here separately.
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=
